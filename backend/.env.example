# MarcosScript Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env or any files containing real secrets to git

# ===========================================
# GOOGLE DRIVE CONFIGURATION
# ===========================================
# Path to the service account credentials JSON file (e.g., credentials/service_account.json)
# The JSON file should contain the service account key from Google Cloud Console
GOOGLE_DRIVE_CREDENTIALS_PATH=
# The ID of the Google Drive folder where processed photos will be uploaded
GOOGLE_DRIVE_FOLDER_ID=
# Permission type for uploaded files: "reader" (anyone with link) or "writer"
# Default: reader (public link - anyone with the link can view)
DRIVE_LINK_PERMISSION=reader

# ===========================================
# CIP SERVICE CONFIGURATION
# ===========================================
# Base URL for the CIP (Colegiado Information Service) lookup API
# Example: http://172.16.93.83:9001/api/v1/colegiado/
CIP_SERVICE_URL=http://172.16.93.83:9001/api/v1/colegiado/
# Optional: Header name for auth token (e.g., "Authorization")
CIP_AUTH_HEADER=
# Optional: Auth token value (will be sent as {header}: {token})
CIP_AUTH_TOKEN=

# ===========================================
# NOTI EMAIL SERVICE CONFIGURATION
# ===========================================
# Base URL of the noti email service
# Example: http://localhost:8080 or http://noti.internal:9000
URL_SERVICIOS_NOTI=http://localhost:9000
# The notificante ID to use when sending emails via noti
NOTI_NOTIFICANTE_ID=MarcosScript
# Timeout for noti requests in seconds
NOTI_TIMEOUT_SECONDS=30

# ===========================================
# APPLICATION DEFAULTS
# ===========================================
# Default usuarioCreacion value when not provided in requests
DEFAULT_USUARIO_CREACION=MarcosScript_Backend

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# These are read by the frontend via VITE_ prefix in frontend/.env
# VITE_API_BASE=http://localhost:8000